<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.3</Version>
    <Authors>Raypro</Authors>
    <Description>Tgs GameInterface WMCasinoService Client</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Protos\gameinterfacewmcasinoservice.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.46.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.46.0" />
    <PackageReference Include="Grpc.Tools" Version="2.46.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\gameinterfacewmcasinoservice.proto" GrpcServices="Client" />
  </ItemGroup>

</Project>
